# Whitelist approach: ignore EVERYTHING by default, then explicitly allow
# only the files that make up the public GitHub Pages site.
# This protects the financial PDFs, business docs, node_modules, and other
# local working files from ever being committed/published.

/*

# --- Published site files (root) ---
!index.html
!onboarding.html
!audit.html
!fontaine.html
!team.html
!sales.html
!os.html
!member-intake.html
!director-dashboard.html
!weekly-meeting.html
!contributor-payouts.html
!accelerator-boost-checklist.html
!accelerator-vault.html
!niche-finder.html
!value-architect.html
!member-pathways.html
!submissions-admin.html
!standards-checklist.html
!affiliates.html
!vsl.html
!optin.html
!team-manual.html
!sales-manual.html
!sales-process.html
!accountability-chart.html
!landing-page.html
!favicon.svg
!breedwise-logo.png
!Fontaine.jpg
!download.jpg
!CNAME
!.gitignore

# --- Masterclass funnel pages (go.breedwise.io) — track go-site/masterclass/ only ---
!/go-site/
/go-site/*
!/go-site/masterclass/

# --- Case Study funnel pages (go.breedwise.io/freecasestudy) ---
!/go-site/freecasestudy/

# --- Six Figure Breeder Summit page (mirror of root /summit) ---
!/go-site/summit/

# --- Masterclass opt-in edge function (source of truth; deploys via Supabase CLI) ---
!/supabase/
/supabase/*
!/supabase/functions/
/supabase/functions/*
!/supabase/functions/masterclass-optin/
!/supabase/functions/booking-notify/
